index 0000000..fb56fc9
--- /dev/null
+++ b/Extension/World/physics_daz_guard.cpp
@@ -0,0 +1,103 @@
+#include "physics_daz_guard.h"
+#include "Engine/Core/Hooks/patches.h"
+#include "Engine/Core/Log/logging.h"
+#include "Engine/Core/Platform/memory.h"
+#include "Engine/Game/Build/addresses.h"
+#include "Engine/Game/Build/20260929/physics_daz.h"
+#include <Windows.h>
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <span>
+
+namespace dingosdk::physics_daz_guard {
+namespace {
+namespace pd = addr::physics_daz;
+std::atomic<bool> installed{};
+std::atomic<std::uint32_t> count{};
+constexpr float flt_min = 1.17549435e-38f;   // the smallest normal float: x >= it  <=>  x > 0 with DAZ
+constexpr std::size_t stub_size = 16;
+
+struct Operands { int dst, x; };
+// 'vcmpltps dst, zero, x' (predicate 1, register form) in its 2- or 3-byte VEX encoding.
+bool decode(const pd::Guard& g, Operands& o) noexcept {
+    const auto* b = g.bytes;
+    if (g.size == 5 && b[0] == 0xC5 && b[2] == 0xC2 && (b[3] & 0xC0) == 0xC0 && b[4] == 0x01 && (b[1] & 7) == 0) {
+        o.dst = ((b[3] >> 3) & 7) | (((~b[1] >> 7) & 1) << 3);
+        o.x = b[3] & 7;
+        return true;
+    }
+    if (g.size == 6 && b[0] == 0xC4 && (b[1] & 0x1F) == 1 && b[3] == 0xC2 && (b[4] & 0xC0) == 0xC0 && b[5] == 0x01 && (b[2] & 7) == 0) {
+        o.dst = ((b[4] >> 3) & 7) | (((~b[1] >> 7) & 1) << 3);
+        o.x = (b[4] & 7) | (((~b[1] >> 5) & 1) << 3);
+        return true;
+    }
+    return false;
+}
+// vcmpps xmm<dst>, xmm<x>, [rip + floor], 1Dh (GE_OQ) ; jmp back
+void write_stub(std::uint8_t* s, const Operands& o, const float* floor, std::uintptr_t back) noexcept {
+    s[0] = 0xC4;
+    s[1] = static_cast<std::uint8_t>((o.dst < 8 ? 0x80 : 0) | 0x40 | 0x20 | 0x01);
+    s[2] = static_cast<std::uint8_t>(((~o.x) & 0xF) << 3);
+    s[3] = 0xC2;
+    s[4] = static_cast<std::uint8_t>(((o.dst & 7) << 3) | 0x05);
+    const auto disp = static_cast<std::int32_t>(reinterpret_cast<std::intptr_t>(floor) - reinterpret_cast<std::intptr_t>(s + 10));
+    std::memcpy(s + 5, &disp, 4);
+    s[9] = 0x1D;
+    s[10] = 0xE9;
+    const auto rel = static_cast<std::int32_t>(static_cast<std::intptr_t>(back) - reinterpret_cast<std::intptr_t>(s + 15));
+    std::memcpy(s + 11, &rel, 4);
+    s[15] = 0xCC;
+}
+} // namespace
+
+bool install(std::uintptr_t base) noexcept {
+    if (installed.exchange(true)) return count.load() != 0;
+    if (!base) return false;
+    char setting[8]{};
+    if (GetEnvironmentVariableA("RESKATE_DAZ_GUARD", setting, sizeof(setting)) && setting[0] == '0') {
+        logging::log(logging::Level::info, logging::Channel::runtime, "Physics DAZ guard: off (RESKATE_DAZ_GUARD=0).");
+        return false;
+    }
+    constexpr auto total = std::size(pd::guards);
+    std::array<Operands, total> operands{};
+    for (std::size_t i = 0; i < total; ++i) {
+        const auto& g = pd::guards[i];
+        std::array<std::uint8_t, 6> here{};
+        if (!decode(g, operands[i]) || !memory::peek_bytes(base + g.rva, here.data(), g.size) ||
+            std::memcmp(here.data(), g.bytes, g.size) != 0) {
+            logging::log(logging::Level::warning, logging::Channel::runtime,
+                "Physics DAZ guard: this build's physics code differs (Skate.exe+0x{:x}); it is left as it is.", g.rva);
+            return false;
+        }
+    }
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
+    const std::size_t bytes = 16 + total * stub_size;
+    auto* page = static_cast<std::uint8_t*>(memory::allocate_near_image(base, nt->OptionalHeader.SizeOfImage, bytes));
+    if (!page) {
+        logging::log(logging::Level::warning, logging::Channel::runtime, "Physics DAZ guard: no memory within reach of the game's code.");
+        return false;
+    }
+    auto* floor = reinterpret_cast<float*>(page);
+    for (int lane = 0; lane < 4; ++lane) floor[lane] = flt_min;
+    for (std::size_t i = 0; i < total; ++i)
+        write_stub(page + 16 + i * stub_size, operands[i], floor, base + pd::guards[i].rva + pd::guards[i].size);
+    DWORD old{};
+    if (!VirtualProtect(page, bytes, PAGE_EXECUTE_READ, &old)) return false;
+    FlushInstructionCache(GetCurrentProcess(), page, bytes);
+    std::uint32_t done{};
+    for (std::size_t i = 0; i < total; ++i) {
+        const auto& g = pd::guards[i];
+        if (patch_code_jump("physics DAZ guard", base + g.rva, std::span<const std::uint8_t>(g.bytes, g.size),
+                            reinterpret_cast<std::uintptr_t>(page + 16 + i * stub_size)) == HookOk)
+            ++done;
+    }
+    count.store(done);
+    logging::log(done == total ? logging::Level::info : logging::Level::warning, logging::Channel::runtime,
+        "Physics DAZ guard: {} of {} solver zero-guards treat denormals as zero.", done, total);
+    return done == total;
+}
+
+std::uint32_t patched() noexcept { return count.load(); }
+} // namespace dingosdk::physics_daz_guard
