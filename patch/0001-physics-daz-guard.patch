--- /dev/null
+++ b/Extension/World/physics_daz_guard.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+
+// The physics solvers divide by lengths and masses behind a guard that only holds when the CPU treats
+// denormals as zero (MXCSR DAZ), which the game turns on for its threads. An x86 emulator that does not
+// honour DAZ (FEX on ARM64: MXCSR reads 0x1f80) lets a denormal through; 1/x becomes +inf, then NaN, and a
+// body's whole state is NaN after one physics step (Engine/Game/Build/<build>/physics_daz.h). The guard
+// rewrites each of those compares so that it gives what x86 gives with DAZ on, on any CPU: a denormal
+// compares as zero. On x86 the game's results are unchanged.
+namespace dingosdk::physics_daz_guard {
+// Checks every site of this build and patches them; once. False when the build differs (nothing patched)
+// or RESKATE_DAZ_GUARD=0.
+bool install(std::uintptr_t base) noexcept;
+// How many compares were rewritten (0 until install has run).
+std::uint32_t patched() noexcept;
+}
