From b259053382e0f6dbb46933675346203be772043d Mon Sep 17 00:00:00 2001
From: ReSkate DAZ guard investigation <noreply@example.invalid>
Date: Sun, 15 Nov 2026 11:19:08 +0000
Subject: [PATCH] diag: log callers of respawn creation and player release

---
 Extension/Skater/skater_observer.cpp | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/Extension/Skater/skater_observer.cpp b/Extension/Skater/skater_observer.cpp
index b1e436a..74472a1 100644
--- a/Extension/Skater/skater_observer.cpp
+++ b/Extension/Skater/skater_observer.cpp
@@ -4,6 +4,8 @@
 #include "Engine/Game/Build/addresses.h"
 #include "Engine/Game/Build/20260929/skater_observer.h"
 #include <atomic>
+#include <cstdio>
+#include <string>
 
 namespace dingosdk {
 namespace {
@@ -20,6 +22,25 @@ struct Observer {
     bool attempted{};
 };
 Observer& observer() { static auto* value = new Observer; return *value; }
+// Diagnostic (respawn-callers branch): who asks for a respawn or releases the skater.
+void log_callers(const char* what, std::uint64_t id) noexcept {
+    static std::atomic<int> budget{40};
+    if (budget.fetch_sub(1) <= 0) return;
+    try {
+        const auto image = observer().base;
+        void* frames[20]{};
+        const auto count = CaptureStackBackTrace(2, 20, frames, nullptr);
+        std::string trace;
+        for (unsigned i = 0; i < count; ++i) {
+            const auto a = reinterpret_cast<std::uintptr_t>(frames[i]);
+            char text[40]{};
+            if (a >= image && a - image < 0x10000000) sprintf_s(text, "Skate.exe+0x%llx", static_cast<unsigned long long>(a - image));
+            else sprintf_s(text, "0x%llx", static_cast<unsigned long long>(a));
+            trace += (i ? " < " : "") + std::string(text);
+        }
+        logging::log(logging::Level::warning, logging::Channel::skater, "CALLERS {} {}: {}", what, id, trace.empty() ? std::string("unknown") : trace);
+    } catch (...) {}
+}
 struct LifecycleLogGate {
     std::atomic<ULONGLONG> next{};
     std::atomic<std::uint64_t> skipped{};
@@ -58,6 +79,7 @@ void create_hook(std::uintptr_t component, std::uint8_t ground_check) {
     const bool report = gate.admit(logging::Channel::skater, "Skater creation");
     if (report) logging::log(logging::Level::info, logging::Channel::skater,
         "Skater creation {} entered (component=0x{:x}, ground_check={}).", id, component, ground_check);
+    if (!ground_check) log_callers("respawn-create", id);
     const auto started = GetTickCount64();
     SetLastError(incoming_error);
     o.create(component, ground_check);
@@ -85,6 +107,7 @@ void bind_hook(std::uintptr_t player, std::uintptr_t entity) {
     if (report) logging::log(logging::Level::info, logging::Channel::player,
         "Player binding {} entered (player=0x{:x}, entity=0x{:x}, action={}).",
         id, player, entity, entity ? "assign" : "release");
+    if (!entity) log_callers("player-release", id);
     const auto started = GetTickCount64();
     SetLastError(incoming_error);
     o.bind(player, entity);
