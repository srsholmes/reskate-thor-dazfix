From 74650e36f8d0016c0bf22bf973076bc29bc7255d Mon Sep 17 00:00:00 2001
From: ReSkate DAZ guard investigation <noreply@example.invalid>
Date: Sun, 15 Nov 2026 13:34:38 +0000
Subject: [PATCH] diag v5: log TeleportManager teleportInternal and its gate

---
 Extension/Skater/skater_observer.cpp | 41 ++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/Extension/Skater/skater_observer.cpp b/Extension/Skater/skater_observer.cpp
index adedb20..5b7679e 100644
--- a/Extension/Skater/skater_observer.cpp
+++ b/Extension/Skater/skater_observer.cpp
@@ -4,6 +4,8 @@
 #include "Engine/Game/Build/addresses.h"
 #include "Engine/Game/Build/20260929/skater_observer.h"
 #include <atomic>
+#include <format>
+#include <intrin.h>
 #include <cstdio>
 #include <string>
 
@@ -153,6 +155,38 @@ template<int N> struct Watched {
         return result;
     }
 };
+// Diagnostic v5: TeleportManager. teleportInternal(mgr) at Skate.exe+0x566740 and its gate
+// canTeleport(mgr) at +0x5647f0 (bool). [mgr] = state (6 WaitingToRemoveAgent, 8 WaitingForPlayer),
+// [mgr+40h] = target position.
+using TeleportFn = void (*)(std::uintptr_t);
+using GateFn = bool (*)(std::uintptr_t);
+TeleportFn original_teleport{};
+GateFn original_gate{};
+std::atomic<std::uint64_t> teleports{}, gates{}, gates_true{};
+std::string mgr_state(std::uintptr_t mgr) {
+    const auto* p = reinterpret_cast<const float*>(mgr + 0x40);
+    return std::format("state={} pos=({:.2f},{:.2f},{:.2f})", *reinterpret_cast<const std::int32_t*>(mgr), p[0], p[1], p[2]);
+}
+void teleport_hook(std::uintptr_t mgr) {
+    const auto from = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
+    const auto before = mgr_state(mgr);
+    original_teleport(mgr);
+    const auto n = ++teleports;
+    if (n <= 40 || n % 100 == 0)
+        logging::log(logging::Level::warning, logging::Channel::skater, "TPM teleportInternal #{} from {} mgr=0x{:x} {} -> {} (gates {} true / {})",
+            n, rva(from), mgr, before, mgr_state(mgr), gates_true.load(), gates.load());
+}
+bool gate_hook(std::uintptr_t mgr) {
+    const auto from = reinterpret_cast<std::uintptr_t>(_ReturnAddress());
+    const bool result = original_gate(mgr);
+    const auto n = ++gates;
+    if (result) ++gates_true;
+    static std::atomic<int> last{-1};
+    const int now = result ? 1 : 0;
+    if (n <= 40 || n % 300 == 0 || last.exchange(now) != now)
+        logging::log(logging::Level::warning, logging::Channel::skater, "TPM gate #{} from {} -> {} {}", n, rva(from), result, mgr_state(mgr));
+    return result;
+}
 void request_pass_hook(std::uintptr_t obj, std::uintptr_t rdx, std::uintptr_t r8, std::uintptr_t r9) {
     in_pass = true;
     original_pass(obj, rdx, r8, r9);
@@ -227,6 +261,13 @@ bool start_skater_observer(std::uintptr_t base) noexcept {
                 logging::write(logging::Level::warning, logging::Channel::skater, "REQUESTER diag hook on Skate.exe+0x2b62410 enabled.");
                 watch<0>(base, 0x4aad0d0);
                 watch<1>(base, 0x4aac2c0);
+                {
+                    void* tp = reinterpret_cast<void*>(base + 0x566740);
+                    void* gate = reinterpret_cast<void*>(base + 0x5647f0);
+                    const bool a = hook_prepare(tp, reinterpret_cast<void*>(&teleport_hook), reinterpret_cast<void**>(&original_teleport)) == HookOk && hook_enable(tp) == HookOk;
+                    const bool b = hook_prepare(gate, reinterpret_cast<void*>(&gate_hook), reinterpret_cast<void**>(&original_gate)) == HookOk && hook_enable(gate) == HookOk;
+                    logging::log(logging::Level::warning, logging::Channel::skater, "TPM hooks: teleportInternal {}, gate {}", a ? "on" : "FAILED", b ? "on" : "FAILED");
+                }
                 char flag[8]{};
                 if (GetEnvironmentVariableA("RESKATE_DIAG_WATCH_SHARED", flag, sizeof(flag)) && flag[0] == '1') watch<2>(base, 0x1fe380);
             }
